-    vbios_bytes, vbios_off = memoryview(bytes(array.array('I', self.nvdev.mmio[0x00300000//4:(0x00300000+0x100000)//4]))), 0
+    # the PROM window can return garbage while a previous session's GSP is still winding down (a process killed with work
+    # stuck on the GPU): read it in 64 KB pieces and keep a piece only once two consecutive reads agree
+    def prom(off:int, n:int) -> bytes: return bytes(array.array('I', self.nvdev.mmio[(0x00300000+off)//4:(0x00300000+off+n)//4]))
+    pieces = []
+    for off in range(0, 0x100000, 0x10000):
+      prev = prom(off, 0x10000)
+      for _ in range(50):
+        cur = prom(off, 0x10000)
+        if cur == prev: break
+        prev = cur
+        time.sleep(0.05)
+      else: raise RuntimeError(f"VBIOS read at {off:#x} never stabilized")
+      pieces.append(cur)
+    vbios_bytes, vbios_off = memoryview(b"".join(pieces)), 0
     while True:
       pci_blck = vbios_bytes[vbios_off + nv.OFFSETOF_PCI_EXP_ROM_PCI_DATA_STRUCT_PTR:].cast('H')[0]
