+extern "C" int strata_pf_mac_compute(void* srcv, int layer, int set, const int32_t* experts, int nd, const float* x, int n_tok, int64_t np,
+                                     const int32_t* eidx, const int32_t* ridx, const float* wt, float* y, double* ms) {
