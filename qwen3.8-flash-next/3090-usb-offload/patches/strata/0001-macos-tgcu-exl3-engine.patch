+// tests/core/exl3_layout_test.cpp - M4: exl3_experts.txt (EXL3 3 bpw expert packs, ~/exl3/pack_exl3.py) parsed by
+// expert_layout_load, without a model or a GPU.
+//
+//   1. No marker: the canonical Q2_0 layout, unchanged.
+//   2. A complete v1 marker at the real geometry (48 layers x 512 experts, 1,862,400 B blobs): every layer's offset
+//      and blob size, the total, the nine field offsets in MoeCoopParams order.
+//   3. The refusals: exl3_pack.json without the marker (pack still being written), a marker beside
+//      native_experts.txt, v2, another format, another geometry, a misaligned / wrong-sized / overlapping /
+//      unknown / repeated / missing field, a missing / repeated / wrong-blob layer, a short sha256.
+//   4. `exl3_layout_test <dir>`: load that directory and print the layout or the refusal (the real pack).
+#include "strata/kernels/cpu/expert_layout.hpp"
+
+#include <chrono>
+#include <cstdio>
+#include <filesystem>
+#include <fstream>
+#include <functional>
+#include <sstream>
+#include <string>
+
+namespace fs = std::filesystem;
+namespace cpu = strata::kernels::cpu;
+
+namespace {
+int g_fail = 0;
+void check(bool ok, const std::string& what) {
+    std::printf("  %-96s %s\n", what.c_str(), ok ? "ok" : "FAIL");
+    if (!ok) ++g_fail;
+}
+
+struct TempDir {
+    fs::path path;
+    TempDir() {
+        path = fs::temp_directory_path() /
+               ("strata-exl3-layout-test-" + std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+        fs::create_directories(path);
+    }
+    ~TempDir() {
+        std::error_code ignored;
+        fs::remove_all(path, ignored);
+    }
+};
+
+constexpr int64_t NL = 48, NEX = 512;
+constexpr uint64_t BLOB = 1862400;
+// pack_exl3.py's byte layout: trellises first, then the fp16 vectors (name, offset, bytes), in MoeCoopParams order.
+struct Field { const char* name; uint64_t off, bytes; };
+const Field kFields[cpu::EXL3_FIELDS] = {
+    {"gate_trellis", 0, 614400},       {"gate_suh", 1843200, 5120}, {"gate_svh", 1848320, 1280},
+    {"up_trellis", 614400, 614400},    {"up_suh", 1849600, 5120},   {"up_svh", 1854720, 1280},
+    {"down_trellis", 1228800, 614400}, {"down_suh", 1856000, 1280}, {"down_svh", 1857280, 5120}};
+const std::string kSha(64, 'a');
+
+struct Marker {
+    std::string header = "# strata exl3 experts v1: exl3-k3-mul1-v1 (n_expert 512, n_embd 2560, n_ff 640, K 3, cb 2, "
+                         "blob 1862400)";
+    std::function<std::string(int, const Field&)> field = [](int, const Field& f) {
+        return "field " + std::string(f.name) + " " + std::to_string(f.off) + " " + std::to_string(f.bytes);
+    };
+    std::function<std::string(int64_t)> layer = [](int64_t l) {
+        return std::to_string(l) + " " + std::to_string((uint64_t) l * NEX * BLOB) + " " + std::to_string(BLOB) + " " +
+               kSha;
+    };
+    std::string text() const {
+        std::ostringstream s;
+        s << header << "\n# field <name> <offset in blob> <bytes>\n";
+        for (int f = 0; f < cpu::EXL3_FIELDS; ++f) {
+            const std::string line = field(f, kFields[f]);
+            if (!line.empty()) s << line << "\n";
+        }
+        s << "# <layer> <offset in experts.bin> <blob> <sha256>\n";
+        for (int64_t l = 0; l < NL; ++l) {
+            const std::string line = layer(l);
+            if (!line.empty()) s << line << "\n";
+        }
+        return s.str();
+    }
+};
+
+void write_text(const fs::path& p, const std::string& s) { std::ofstream(p, std::ios::binary) << s; }
+
+bool load(const fs::path& dir, std::string& err) {
+    err.clear();
+    return cpu::expert_layout_load(dir.string(), NL, NEX, err);
+}
+
+// The marker loads to nothing: refused, and the message names `needle`.
+void refused(const std::string& what, const Marker& m, const std::string& needle) {
+    TempDir d;
+    write_text(d.path / "exl3_experts.txt", m.text());
+    std::string err;
+    const bool ok = load(d.path, err);
+    check(!ok && err.find(needle) != std::string::npos, "refused: " + what + (ok ? "" : "  [" + err + "]"));
+}
+}  // namespace
+
+int main(int argc, char** argv) {
+    std::string err;
+    if (argc == 2) {
+        if (!load(argv[1], err)) {
+            std::printf("%s: refused: %s\n", argv[1], err.c_str());
+            return 2;
+        }
+        const auto& L = cpu::expert_layout();
+        std::printf("%s: exl3 %d native %d v%d n_expert %lld blob %llu total %llu fields", argv[1], L.exl3, L.native,
+                    L.version, (long long) L.n_expert, (unsigned long long) L.max_blob, (unsigned long long) L.total);
+        for (int f = 0; f < cpu::EXL3_FIELDS; ++f) std::printf(" %u", L.exl3_field_off[f]);
+        std::printf("\n");
+        return 0;
+    }
+
+    std::printf("1. no marker\n");
+    {
+        TempDir d;
+        const bool ok = load(d.path, err);
+        const auto& L = cpu::expert_layout();
+        check(ok && !L.exl3 && !L.native && L.blob_bytes(47) == cpu::BLOB &&
+                  L.total == (uint64_t) NL * NEX * cpu::BLOB, "canonical Q2_0 layout");
+    }
+
+    std::printf("2. complete v1 marker\n");
+    {
+        TempDir d;
+        write_text(d.path / "exl3_experts.txt", Marker().text());
+        write_text(d.path / "exl3_pack.json", "{}");
+        const bool ok = load(d.path, err);
+        const auto& L = cpu::expert_layout();
+        check(ok, "loads" + (ok ? std::string() : "  [" + err + "]"));
+        bool layers = true;
+        for (int64_t l = 0; l < NL; ++l)
+            layers &= L.blob_bytes(l) == BLOB && L.layer_offset(l) == (uint64_t) l * NEX * BLOB &&
+                      L.blob_offset(l, 511) == (uint64_t) l * NEX * BLOB + 511 * BLOB;
+        check(ok && L.exl3 && !L.native && L.version == 1 && L.n_expert == NEX, "exl3, v1, 512 experts");
+        check(ok && layers, "48 layers: blob 1862400, layer l at l * 512 * blob, expert e at + e * blob");
+        check(ok && L.total == 45770342400ull && L.max_blob == BLOB, "total 45,770,342,400 B, max_blob = blob");
+        bool fields = true;
+        for (int f = 0; f < cpu::EXL3_FIELDS; ++f) fields &= L.exl3_field_off[f] == kFields[f].off;
+        check(ok && fields, "field offsets in MoeCoopParams order (g_trellis 0, g_suh 1843200, ..., d_svh 1857280)");
+        TempDir e;   // then a canonical pack again: nothing of the EXL3 layout survives
+        check(load(e.path, err) && !cpu::expert_layout().exl3, "a later load of a Q2_0 pack resets the kind");
+    }
+
+    std::printf("3. refusals\n");
+    {
+        TempDir d;
+        write_text(d.path / "exl3_pack.json", "{}");
+        const bool ok = load(d.path, err);
+        check(!ok && err.find("still being written") != std::string::npos, "refused: exl3_pack.json, no marker");
+    }
+    {
+        TempDir d;
+        write_text(d.path / "exl3_experts.txt", Marker().text());
+        write_text(d.path / "native_experts.txt", "# strata native experts v3\n");
+        const bool ok = load(d.path, err);
+        check(!ok && err.find("both") != std::string::npos, "refused: marker beside native_experts.txt");
+    }
+    Marker m;
+    m.header = "# strata exl3 experts v2: exl3-k3-mul1-v1 (n_expert 512, n_embd 2560, n_ff 640, K 3, cb 2, blob 1862400)";
+    refused("v2", m, "reads up to v1");
+    m = Marker();
+    m.header = "# strata exl3 experts v1: exl3-k4-mul1-v1 (n_expert 512, n_embd 2560, n_ff 640, K 4, cb 2, blob 2476800)";
+    refused("format exl3-k4-mul1-v1", m, "exl3-k3-mul1-v1 only");
+    m = Marker();
+    m.header = "# strata exl3 experts v1: exl3-k3-mul1-v1 (n_expert 512, n_embd 4096, n_ff 640, K 3, cb 2, blob 1862400)";
+    refused("n_embd 4096", m, "is not this model's");
+    m.header = "# strata exl3 experts v1: exl3-k3-mul1-v1 (n_expert 512, n_embd 2560, n_ff 640, K 3, cb 1, blob 1862400)";
+    refused("cb 1 (MCG)", m, "is not this model's");
+    m.header = "# strata exl3 experts v1: exl3-k3-mul1-v1 n_expert 512";
+    refused("malformed header", m, "malformed header");
+    m = Marker();
+    m.field = [](int f, const Field& x) {
+        return "field " + std::string(x.name) + " " + std::to_string(x.off + (f == 1 ? 16 : 0)) + " " +
+               std::to_string(x.bytes);
+    };
+    refused("gate_suh at +16 (not 256-aligned)", m, "256-byte aligned");
+    m.field = [](int f, const Field& x) {
+        return "field " + std::string(x.name) + " " + std::to_string(x.off) + " " +
+               std::to_string(x.bytes + (f == 8 ? 2 : 0));
+    };
+    refused("down_svh 5122 B", m, "wants 5120 B");
+    m.field = [](int f, const Field& x) {
+        return "field " + std::string(x.name) + " " + std::to_string(f == 4 ? 1848320 : x.off) + " " +
+               std::to_string(x.bytes);
+    };
+    refused("up_suh over gate_svh", m, "overlap");
+    m.field = [](int f, const Field& x) {
+        return "field " + std::string(f == 2 ? "gate_sv" : x.name) + " " + std::to_string(x.off) + " " +
+               std::to_string(x.bytes);
+    };
+    refused("unknown field gate_sv", m, "unknown field");
+    m.field = [](int f, const Field& x) {
+        const Field& y = f == 5 ? kFields[4] : x;
+        return "field " + std::string(y.name) + " " + std::to_string(y.off) + " " + std::to_string(y.bytes);
+    };
+    refused("up_suh twice", m, "repeated field");
+    m.field = [](int f, const Field& x) {
+        return f == 6 ? std::string() : "field " + std::string(x.name) + " " + std::to_string(x.off) + " " +
+                                            std::to_string(x.bytes);
+    };
+    refused("down_trellis missing", m, "down_trellis is missing");
+    m = Marker();
+    m.layer = [](int64_t l) {
+        return l == 47 ? std::string()
+                       : std::to_string(l) + " " + std::to_string((uint64_t) l * NEX * BLOB) + " " +
+                             std::to_string(BLOB) + " " + kSha;
+    };
+    refused("layer 47 missing (a partial pack)", m, "47 of 48 layers listed");
+    m.layer = [](int64_t l) {
+        const int64_t k = l == 47 ? 46 : l;
+        return std::to_string(k) + " " + std::to_string((uint64_t) k * NEX * BLOB) + " " + std::to_string(BLOB) + " " +
+               kSha;
+    };
+    refused("layer 46 twice", m, "listed twice");
+    m.layer = [](int64_t l) {
+        return std::to_string(l) + " " + std::to_string((uint64_t) l * NEX * BLOB) + " " +
+               std::to_string(l == 5 ? 1382400 : BLOB) + " " + kSha;
+    };
+    refused("layer 5 blob 1382400", m, "blob is not the header's");
+    m.layer = [](int64_t l) {
+        return std::to_string(l) + " " + std::to_string((uint64_t) l * NEX * BLOB + (l == 9 ? 256 : 0)) + " " +
+               std::to_string(BLOB) + " " + kSha;
+    };
+    refused("layer 9 offset +256", m, "not contiguous");
+    m.layer = [](int64_t l) {
+        return std::to_string(l) + " " + std::to_string((uint64_t) l * NEX * BLOB) + " " + std::to_string(BLOB) +
+               (l == 3 ? " abc" : " " + kSha);
+    };
+    refused("layer 3 short sha256", m, "malformed layer line");
+
+    std::printf(g_fail ? "FAILED %d\n" : "ALL PASS\n", g_fail);
+    return g_fail ? 1 : 0;
+}
