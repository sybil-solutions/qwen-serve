+        {
+            std::lock_guard<std::mutex> lk(mu);
+            own = j; own_dst = dst; has_dst = true; jobs = &own; fd = fd_; n = own.size(); next.store(0); completed.store(0); ++gen; active = true;
+        }
+        cv.notify_all();
+        finish();
+    }
+};
