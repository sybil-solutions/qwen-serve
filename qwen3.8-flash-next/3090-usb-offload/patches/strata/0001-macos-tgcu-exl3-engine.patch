+                    {
+                        std::unique_lock<std::mutex> lk(mu);
+                        cv.wait(lk, [&] { return quit || gen != seen; });
+                        if (quit) return;
+                        seen = gen;
+                    }
+                    drain();
+                }
+            });
+    }
+    std::vector<std::pair<uint64_t, uint64_t>> own;
+    std::vector<uint8_t*> own_dst;
+    bool has_dst = false;
+    bool active = false;
