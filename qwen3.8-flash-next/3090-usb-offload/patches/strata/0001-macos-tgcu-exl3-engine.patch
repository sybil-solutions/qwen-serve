+        finish();
+        if (j.empty()) return;
+        {
+            std::lock_guard<std::mutex> lk(mu);
+            own = j; has_dst = false; jobs = &own; fd = fd_; n = own.size(); next.store(0); completed.store(0); ++gen; active = true;
+        }
+        cv.notify_all();
+    }
+    void finish() {
+        if (!active) return;
+        drain();
+        std::unique_lock<std::mutex> lk(mu);
