+        }
+        pos += (uint64_t) blob * (uint64_t) n_expert;
+    }
+    L.exl3 = true;
+    L.exl3_stride = (uint64_t) blob;
+    L.max_blob = (uint64_t) blob;
+    L.total = pos;
+    return true;
