# run-strata.sh sources ~/.chestnut_env (not in this repo). Its whole content on the mini is these three lines (paths, no secrets):
export PATH="$HOME/.local/bin:$PATH"                      # colima / docker / uv
export LIBUSB_PATH="$HOME/tinygrad/.venv/lib/python3.12/site-packages/libusb_package/libusb-1.0.dylib"   # libusb-package 1.0.30.0 wheel inside the tinygrad venv
export COMGR_PATH="$HOME/.local/lib/libamd_comgr.dylib"   # 111 MB; tinygrad's AMD compiler library, loaded at import. Source not pinned (see docs/reproduce.md)
